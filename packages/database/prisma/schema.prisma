generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  name         String?
  email        String           @unique
  role         String           @default("user")
  status       String           @default("active")
  passwordHash String?
  emailVerifiedAt DateTime?
  emailVerificationTokenHash String?
  emailVerificationTokenExpiresAt DateTime?
  twoFactorSecret String?
  twoFactorEnabledAt DateTime?
  twoFactorBackupCodes Json?
  lastLoginAt  DateTime?
  invitedAt    DateTime?
  disabledAt   DateTime?
  permissions  UserPermission[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
  @@index([emailVerificationTokenHash])
}

model CompanySettings {
  id          String   @id @default(cuid())
  company     String
  owner       String?
  street      String?
  zip         String?
  city        String?
  country     String   @default("Deutschland")
  email       String?
  phone       String?
  website     String?
  taxNumber   String?
  vatId       String?
  iban        String?
  bic         String?
  bankName    String?
  registerCourt String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Customer {
  id        String    @id @default(cuid())
  number    String    @unique
  name      String
  contact   String?
  email     String?
  phone     String?
  street    String?
  zip       String?
  city      String?
  country   String    @default("Deutschland")
  notes     String?
  status    String    @default("active")
  projects  Project[]
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  status      String    @default("active")
  description String?
  budget      Decimal?  @db.Decimal(12, 2)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  invoices    Invoice[]
  timeEntries TimeEntry[]
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([customerId])
}

model TimeEntry {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectName String
  task        String
  hours       Decimal  @db.Decimal(12, 2)
  rate        Decimal  @default(0) @db.Decimal(12, 2)
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  status      String   @default("billable")
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([date])
  @@index([status])
}

model Expense {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectName String
  title       String
  category    String?
  vendor      String?
  amount      Decimal  @db.Decimal(12, 2)
  status      String   @default("recorded")
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([date])
  @@index([status])
}

model Article {
  id          String   @id @default(cuid())
  number      String   @unique
  name        String
  category    String?
  description String?
  unit        String   @default("Stk")
  netPrice    Decimal  @db.Decimal(12, 2)
  vatRate     Decimal  @default(19) @db.Decimal(5, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invoice {
  id          String            @id @default(cuid())
  number      String            @unique
  type        String            @default("invoice")
  status      String            @default("draft")
  issueDate   DateTime          @default(now())
  dueDate     DateTime?
  paidAt      DateTime?
  customerId  String?
  customer    Customer?         @relation(fields: [customerId], references: [id])
  projectId   String?
  project     Project?          @relation(fields: [projectId], references: [id])
  positions   InvoicePosition[]
  payments    Payment[]
  netTotal    Decimal           @default(0) @db.Decimal(12, 2)
  vatTotal    Decimal           @default(0) @db.Decimal(12, 2)
  grossTotal  Decimal           @default(0) @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([customerId])
  @@index([projectId])
}

model InvoicePosition {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  title       String
  description String?
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unit        String   @default("Stk")
  netPrice    Decimal  @db.Decimal(12, 2)
  vatRate     Decimal  @default(19) @db.Decimal(5, 2)
  sortOrder   Int      @default(0)
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("EUR")
  method      String?
  reference   String?
  paidAt      DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model NumberRange {
  id        String   @id @default(cuid())
  type      String   @unique
  prefix    String
  nextValue Int      @default(1)
  padding   Int      @default(4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  reason    String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}


model UserPermission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String
  action    String
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, scope, action])
}


model License {
  id           String   @id @default(cuid())
  keyHash      String?  @unique
  plan         String   @default("free")
  billingCycle String   @default("free")
  maxUsers     Int      @default(5)
  status       String   @default("active")
  company      String?
  validUntil   DateTime?
  features     Json?
  activatedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, validUntil, updatedAt])
}
