generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  name         String?
  email        String           @unique
  role         String           @default("user")
  status       String           @default("active")
  passwordHash String?
  emailVerifiedAt DateTime?
  emailVerificationTokenHash String?
  emailVerificationTokenExpiresAt DateTime?
  twoFactorSecret String?
  twoFactorEnabledAt DateTime?
  twoFactorBackupCodes Json?
  lastLoginAt  DateTime?
  invitedAt    DateTime?
  disabledAt   DateTime?
  permissions  UserPermission[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
  @@index([emailVerificationTokenHash])
}

model CompanySettings {
  id          String   @id @default(cuid())
  company     String
  owner       String?
  street      String?
  zip         String?
  city        String?
  country     String   @default("Deutschland")
  email       String?
  phone       String?
  website     String?
  taxNumber   String?
  vatId       String?
  iban        String?
  bic         String?
  bankName    String?
  defaultPaymentTermsDays Int?
  defaultPaymentNote String?
  registerCourt String?
  logoUrl     String?
  bankAccounts BankAccount[]
  paymentMethods PaymentMethodConfig[]
  paymentProviderConfigs PaymentProviderConfig[]
  paymentTerms PaymentTermConfig[]
  reminderPreparations ReminderPreparation[]
  aiProviderConfigs AiProviderConfig[]
  bankConnections BankConnection[]
  openBankingAccounts OpenBankingAccount[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Customer {
  id        String    @id @default(cuid())
  number    String    @unique
  name      String
  contact   String?
  email     String?
  phone     String?
  street    String?
  zip       String?
  city      String?
  country   String    @default("Deutschland")
  notes     String?
  status    String    @default("active")
  preferredPaymentMethod String?
  paymentTermsDays Int?
  portalEmail String? @unique
  portalPasswordHash String?
  portalInviteTokenHash String?
  portalInviteExpiresAt DateTime?
  portalLastLoginAt DateTime?
  projects  Project[]
  invoices  Invoice[]
  customerPositions InvoicePosition[]
  timeProjects TimeProject[]
  documentAssets DocumentAsset[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  status       String        @default("active")
  description  String?
  startDate    DateTime?
  endDate      DateTime?
  budget       Decimal?      @db.Decimal(12, 2)
  hourlyRate   Decimal?      @db.Decimal(12, 2)
  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id])
  invoices     Invoice[]
  timeEntries  TimeEntry[]
  timeProjects TimeProject[]
  invoicePositions InvoicePosition[]
  expenses     Expense[]
  documentAssets DocumentAsset[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([customerId])
}

model TimeEntry {
  id               String            @id @default(cuid())
  projectId        String?
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  timeProjectId    String?
  timeProject      TimeProject?      @relation(fields: [timeProjectId], references: [id], onDelete: SetNull)
  articleId        String?
  article          Article?          @relation(fields: [articleId], references: [id], onDelete: SetNull)
  projectName      String
  task             String
  hours            Decimal           @db.Decimal(12, 2)
  rate             Decimal           @default(0) @db.Decimal(12, 2)
  amount           Decimal           @default(0) @db.Decimal(12, 2)
  status           String            @default("billable")
  billingStatus    String            @default("not_billable")
  date             DateTime          @default(now())
  invoiceTimeLinks InvoiceTimeLink[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([projectId])
  @@index([timeProjectId])
  @@index([articleId])
  @@index([date])
  @@index([status])
  @@index([billingStatus])
}

model TimeProject {
  id          String      @id @default(cuid())
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  code        String?
  name        String
  description String?
  status      String      @default("prepared")
  hourlyRate  Decimal?    @db.Decimal(12, 2)
  capacityHours Decimal?  @db.Decimal(12, 2)
  billable    Boolean     @default(false)
  timeEntries TimeEntry[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([customerId])
  @@index([projectId])
  @@index([status])
}

model InvoiceTimeLink {
  id          String    @id @default(cuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  timeEntryId String
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  hours       Decimal   @db.Decimal(12, 2)
  amount      Decimal   @default(0) @db.Decimal(12, 2)
  status      String    @default("prepared")
  createdAt   DateTime  @default(now())

  @@unique([invoiceId, timeEntryId])
  @@index([invoiceId])
  @@index([timeEntryId])
  @@index([status])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  module      String
  label       String
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([module])
  @@index([enabled])
}

model Expense {
  id          String       @id @default(cuid())
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectName String
  title       String
  category    String?
  vendor      String?
  amount      Decimal      @db.Decimal(12, 2)
  status      String       @default("recorded")
  date        DateTime     @default(now())
  attachments Attachment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId])
  @@index([date])
  @@index([status])
}

model Attachment {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  storagePath  String
  checksum     String?
  expenseId    String?
  expense      Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdById  String?
  createdAt    DateTime @default(now())

  @@index([expenseId])
  @@index([createdById])
}

model Article {
  id          String      @id @default(cuid())
  number      String      @unique
  name        String
  category    String?
  description String?
  unit        String      @default("Stk")
  netPrice    Decimal     @db.Decimal(12, 2)
  vatRate     Decimal     @default(19) @db.Decimal(5, 2)
  active      Boolean     @default(true)
  timeEntries TimeEntry[]
  articlePositions InvoicePosition[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Invoice {
  id          String            @id @default(cuid())
  number      String            @unique
  type        String            @default("invoice")
  status      String            @default("draft")
  issueDate   DateTime          @default(now())
  dueDate     DateTime?
  paidAt      DateTime?
  customerId  String?
  customer    Customer?         @relation(fields: [customerId], references: [id])
  projectId   String?
  project     Project?          @relation(fields: [projectId], references: [id])
  positions   InvoicePosition[]
  payments    Payment[]
  paymentLinks PaymentLink[]
  timeLinks   InvoiceTimeLink[]
  documentAssets DocumentAsset[]
  matchedBankTransactions BankTransaction[]
  bankAccountId String?
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  bankNameSnapshot String?
  accountHolderSnapshot String?
  ibanSnapshot String?
  bicSnapshot String?
  paymentMethod String?
  bankTransactionId String?
  matchedBy String?
  paymentTermsDays Int?
  qrPaymentPayload String?
  netTotal    Decimal           @default(0) @db.Decimal(12, 2)
  vatTotal    Decimal           @default(0) @db.Decimal(12, 2)
  grossTotal  Decimal           @default(0) @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([customerId])
  @@index([projectId])
  @@index([bankAccountId])
  @@index([bankTransactionId])
  @@index([matchedBy])
}

model AiProviderConfig {
  id                String           @id @default(cuid())
  companySettingsId String?
  companySettings   CompanySettings? @relation(fields: [companySettingsId], references: [id], onDelete: SetNull)
  provider          String
  model             String
  label             String
  endpoint          String?
  enabled           Boolean          @default(false)
  localOnly         Boolean          @default(false)
  apiKeyConfigured  Boolean          @default(false)
  sortOrder         Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([companySettingsId, provider, model])
  @@index([provider])
  @@index([enabled])
}

model DocumentAsset {
  id              String    @id @default(cuid())
  name            String
  originalName    String
  documentType    String
  mimeType        String
  size            Int
  storagePath     String
  checksum        String?
  status          String    @default("open")
  version         Int       @default(1)
  changeLog       Json?
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invoiceId       String?
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  offerInvoiceId  String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([name])
  @@index([documentType])
  @@index([status])
  @@index([customerId])
  @@index([projectId])
  @@index([invoiceId])
  @@index([offerInvoiceId])
  @@index([createdAt])
}

model InvoicePosition {
  id          String    @id @default(cuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  articleId   String?
  article     Article?  @relation(fields: [articleId], references: [id], onDelete: SetNull)
  title       String
  description String?
  quantity    Decimal   @default(1) @db.Decimal(12, 2)
  unit        String    @default("Stk")
  hours       Decimal?  @db.Decimal(12, 2)
  hourlyRate  Decimal?  @db.Decimal(12, 2)
  amount      Decimal?  @db.Decimal(12, 2)
  netPrice    Decimal   @db.Decimal(12, 2)
  vatRate     Decimal   @default(19) @db.Decimal(5, 2)
  sortOrder   Int       @default(0)

  @@index([customerId])
  @@index([projectId])
  @@index([articleId])
}

model BankAccount {
  id                String           @id @default(cuid())
  companySettingsId String?
  companySettings   CompanySettings? @relation(fields: [companySettingsId], references: [id], onDelete: SetNull)
  bankName          String
  accountHolder     String
  iban              String
  bic               String?
  isDefault         Boolean          @default(false)
  qrEnabled         Boolean          @default(true)
  active            Boolean          @default(true)
  invoices          Invoice[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([companySettingsId])
  @@index([isDefault])
  @@index([active])
}


model BankConnection {
  id                    String               @id @default(cuid())
  companySettingsId     String?
  companySettings       CompanySettings?     @relation(fields: [companySettingsId], references: [id], onDelete: SetNull)
  provider              String               @default("finapi")
  providerConnectionId  String?
  displayName           String               @default("finAPI Verbindung")
  status                String               @default("prepared")
  consentStatus         String               @default("not_started")
  connectedAt           DateTime?
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  tokenMetadata         Json?
  webhookUrl            String?
  syncEnabled           Boolean              @default(false)
  lastSyncedAt          DateTime?
  lastSyncStatus        String               @default("pending")
  auditState            String               @default("prepared")
  accounts              OpenBankingAccount[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([companySettingsId])
  @@index([provider])
  @@index([status])
  @@index([consentStatus])
  @@index([lastSyncedAt])
  @@map("BankConnections")
}

model OpenBankingAccount {
  id                String            @id @default(cuid())
  companySettingsId String?
  companySettings   CompanySettings?  @relation(fields: [companySettingsId], references: [id], onDelete: SetNull)
  connectionId      String?
  connection        BankConnection?    @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  provider          String            @default("finapi")
  providerAccountId String?
  accountName       String
  bankName          String?
  ibanMasked        String?
  currency          String            @default("EUR")
  isDefault         Boolean           @default(false)
  status            String            @default("prepared")
  currentBalance    Decimal?          @db.Decimal(12, 2)
  lastSyncedAt      DateTime?
  transactions      BankTransaction[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([companySettingsId])
  @@index([connectionId])
  @@index([provider])
  @@index([status])
  @@index([isDefault])
  @@map("BankAccounts")
}

model BankTransaction {
  id                    String              @id @default(cuid())
  openBankingAccountId  String
  openBankingAccount    OpenBankingAccount  @relation(fields: [openBankingAccountId], references: [id], onDelete: Cascade)
  matchedInvoiceId      String?
  matchedInvoice        Invoice?            @relation(fields: [matchedInvoiceId], references: [id], onDelete: SetNull)
  linkedInvoiceId       String?
  provider              String              @default("finapi")
  providerTransactionId String?
  amount                Decimal             @db.Decimal(12, 2)
  currency              String              @default("EUR")
  bookedAt              DateTime?
  valueDate             DateTime?
  purpose               String?
  counterpartyName      String?
  counterpartyIbanMasked String?
  reference             String?
  status                String              @default("unmatched")
  matchConfidence       Decimal?            @db.Decimal(5, 2)
  matchedAt             DateTime?
  matchedBy             String?
  paymentStatusAction   String              @default("prepared")
  rawData               Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([openBankingAccountId, providerTransactionId])
  @@index([openBankingAccountId])
  @@index([matchedInvoiceId])
  @@index([linkedInvoiceId])
  @@index([matchedAt])
  @@index([matchedBy])
  @@index([provider])
  @@index([status])
  @@index([bookedAt])
  @@index([valueDate])
  @@map("BankTransactions")
}

model PaymentMethodConfig {
  id                String           @id @default(cuid())
  companySettingsId String?
  companySettings   CompanySettings? @relation(fields: [companySettingsId], references: [id], onDelete: SetNull)
  key               String
  label             String
  enabled           Boolean          @default(true)
  prepared          Boolean          @default(false)
  sortOrder         Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([companySettingsId, key])
  @@index([enabled])
}

model PaymentProviderConfig {
  id                String           @id @default(cuid())
  companySettingsId String?
  companySettings   CompanySettings? @relation(fields: [companySettingsId], references: [id], onDelete: SetNull)
  provider          String
  apiKey            String?
  secretKey         String?
  webhookUrl        String?
  enabled           Boolean          @default(false)
  connectedAt       DateTime?
  lastStatus        String           @default("open")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([companySettingsId, provider])
  @@index([provider])
  @@index([enabled])
}

model PaymentTermConfig {
  id                String           @id @default(cuid())
  companySettingsId String?
  companySettings   CompanySettings? @relation(fields: [companySettingsId], references: [id], onDelete: SetNull)
  label             String
  days              Int
  isDefault         Boolean          @default(false)
  active            Boolean          @default(true)
  sortOrder         Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([companySettingsId])
  @@index([isDefault])
  @@index([active])
}

model ReminderPreparation {
  id                String           @id @default(cuid())
  companySettingsId String?
  companySettings   CompanySettings? @relation(fields: [companySettingsId], references: [id], onDelete: SetNull)
  level             Int
  label             String
  daysAfterDue      Int
  active            Boolean          @default(false)
  templateNote      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([companySettingsId])
  @@index([level])
}

model PaymentLink {
  id                String   @id @default(cuid())
  invoiceId         String
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  provider          String
  status            String   @default("open")
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("EUR")
  checkoutUrl       String
  providerPaymentId String?
  metadata          Json?
  expiresAt         DateTime?
  paidAt            DateTime?
  failedAt          DateTime?
  canceledAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([invoiceId, provider])
  @@index([provider])
  @@index([status])
  @@index([providerPaymentId])
}

model Payment {
  id                String   @id @default(cuid())
  invoiceId         String?
  invoice           Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("EUR")
  method            String?
  reference         String?
  status            String   @default("paid")
  provider          String?
  providerPaymentId String?  @unique
  checkoutUrl       String?
  failureReason     String?
  paidAt            DateTime @default(now())
  canceledAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([invoiceId])
  @@index([status])
  @@index([provider])
  @@index([providerPaymentId])
}

model NumberRange {
  id        String   @id @default(cuid())
  type      String   @unique
  prefix    String
  nextValue Int      @default(1)
  padding   Int      @default(4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id                   String   @id @default(cuid())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  title                String   @default("Audit Event")
  description          String?
  module               String   @default("system")
  level                String   @default("info")
  status               String   @default("active")
  actorId              String?
  actorName            String?
  actorEmail           String?
  actorRole            String?
  ipAddress            String?
  browserName          String?
  browserVersion       String?
  osName               String?
  osVersion            String?
  country              String?
  city                 String?
  timezone             String?
  requestId            String?
  sessionId            String?
  traceId              String?
  userAgent            String?
  referer              String?
  method               String?
  endpoint             String?
  duration             Int?
  tags                 String[] @default([])
  metadata             Json?
  archived             Boolean  @default(false)
  archivedAt           DateTime?
  searchableText       String?

  action               String?
  entity               String?
  entityId             String?
  reason               String?
  data                 Json?
  tenantId             String?
  workspaceId          String?
  type                 String   @default("legacy")
  source               String   @default("system")
  severity             String   @default("info")
  moduleKey            String?
  integrationKey       String?
  marketplaceModuleKey String?
  entityType           String?
  publicIp             String?
  privateIp            String?
  accessHost           String?
  accessProtocol       String?
  accessOrigin         String?
  browser              String?
  device               String?
  operatingSystem      String?
  deviceType           String?
  location             String?
  region               String?
  geoProvider          String?
  before               Json?
  after                Json?

  @@index([createdAt])
  @@index([module])
  @@index([level])
  @@index([status])
  @@index([actorId])
  @@index([actorEmail])
  @@index([ipAddress])
  @@index([requestId])
  @@index([archived])
  @@index([createdAt, archived])
  @@index([module, level])
  @@index([actorId, createdAt])
  @@index([tenantId])
  @@index([workspaceId])
  @@index([type])
  @@index([source])
  @@index([severity])
  @@index([moduleKey])
  @@index([integrationKey])
  @@index([marketplaceModuleKey])
}


model LogSettings {
  id               String   @id @default(cuid())
  retention        String   @default("30")
  autoArchive      Boolean  @default(true)
  archiveDayOfWeek Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}


model UserPermission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String
  action    String
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, scope, action])
}


model License {
  id           String   @id @default(cuid())
  keyHash      String?  @unique
  plan         String   @default("free")
  billingCycle String   @default("free")
  maxUsers     Int      @default(5)
  status       String   @default("active")
  company      String?
  validUntil   DateTime?
  features     Json?
  activatedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, validUntil, updatedAt])
}

model LicenseIssue {
  id              String   @id @default(cuid())
  licenseId       String   @unique
  keyHash         String   @unique
  keyPreview      String
  plan            String
  billingCycle    String
  maxUsers        Int
  status          String   @default("issued")
  customerId      String?
  customerName    String?
  validUntil      DateTime?
  features        Json?
  issuedByUserId  String?
  activatedAt     DateTime?
  activatedLicenseId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, validUntil, updatedAt])
  @@index([customerName])
}


model AutomationWorkflow {
  id          String   @id @default(cuid())
  name        String
  trigger     String
  action      String
  status      String   @default("active")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([trigger])
  @@index([status])
}

model RecurringInvoiceRule {
  id          String   @id @default(cuid())
  name        String
  frequency   String
  interval    Int      @default(1)
  nextRunAt   DateTime?
  customerId  String?
  projectId   String?
  status      String   @default("prepared")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([frequency])
  @@index([status])
  @@index([nextRunAt])
}

model PaymentReminderRule {
  id             String   @id @default(cuid())
  name           String
  timing         String
  offsetDays     Int      @default(0)
  reminderLevel  Int?
  status         String   @default("prepared")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([timing])
  @@index([reminderLevel])
  @@index([status])
}
