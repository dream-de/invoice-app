{
  "extends": "../../packages/config/typescript/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./*"
      ],
      "@dream-invoice/auth": [
        "../../packages/auth/src/index.ts"
      ],
      "@dream-invoice/database": [
        "../../packages/database/src/index.ts"
      ],
      "@dream-invoice/ui": [
        "../../packages/ui/src/index.ts"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
