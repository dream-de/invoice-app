# DreamInvoice Web Pro preview runtime.
# apps/web remains the active production runtime. Do not bind web-pro to 3012.

NODE_ENV=production
NEXT_PUBLIC_APP_NAME="Dream Invoice Pro"

# Recommended preview port. Keeps web-pro separate from the active apps/web host port 3012.
WEB_PRO_PORT=3020
PORT=3020
HOSTNAME=0.0.0.0

# Preview health endpoint:
#   http://127.0.0.1:3020/api/health

# Reuse shared environment only in an intentional preview run.
DATABASE_URL=""
AUTH_SECRET=""
AUTH_COOKIE_SECURE=false
LICENSE_PUBLIC_KEY=""

# Optional preview image override for docker-compose.web-pro.example.yml.
DREAM_INVOICE_WEB_PRO_IMAGE=ghcr.io/dream-de/invoice-app-web-pro:preview
NEXT_PUBLIC_WEB_PRO_APP_NAME="Dream Invoice Pro"
