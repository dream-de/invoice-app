{
  "extends": "../../packages/config/typescript/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*",
        "../web/src/*"
      ],
      "@dream-invoice/premium": [
        "../../packages/premium/src/index.ts"
      ],
      "@dream-invoice/premium/*": [
        "../../packages/premium/src/*"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
