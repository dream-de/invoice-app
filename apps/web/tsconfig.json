{
  "extends": "../../packages/config/typescript/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@dream-invoice/ui": [
        "../../packages/ui/src"
      ],
      "@dream-invoice/database": [
        "../../packages/database/src"
      ],
      "@dream-invoice/utils": [
        "../../packages/utils/src"
      ],
      "@dream-invoice/tax": [
        "../../packages/tax/src"
      ],
      "@dream-invoice/pdf": [
        "../../packages/pdf/src"
      ],
      "@dream-invoice/invoice-core": [
        "../../packages/invoice-core/src"
      ],
      "@dream-invoice/auth": [
        "../../packages/auth/src"
      ],
      "@dream-invoice/premium": [
        "../../packages/premium/src/index.ts"
      ],
      "@dream-invoice/premium/*": [
        "../../packages/premium/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
