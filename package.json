{
  "name": "dream-invoice",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev:web": "pnpm --filter @dream-invoice/web dev",
    "dev:accounting": "pnpm --filter @dream-invoice/accounting dev",
    "dev:admin": "pnpm --filter @dream-invoice/admin dev",
    "dev:server": "pnpm --filter @dream-invoice/server dev",
    "db:generate": "pnpm --filter @dream-invoice/database db:generate",
    "db:migrate": "pnpm --filter @dream-invoice/database db:migrate",
    "db:studio": "pnpm --filter @dream-invoice/database db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:deploy": "pnpm --filter @dream-invoice/database db:deploy",
    "docker:build": "docker compose build",
    "docker:restart": "docker compose restart",
    "prebuild": "pnpm --filter @dream-invoice/database db:generate",
    "worker:server": "pnpm --filter @dream-invoice/server-worker worker",
    "worker:server:smoke": "pnpm --filter @dream-invoice/server-worker worker:smoke",
    "docker:worker": "docker compose -f docker/docker-compose.yml --profile worker run --rm --no-deps server-worker",
    "docker:build:web": "docker compose -f docker/docker-compose.yml build web",
    "docker:build:demo": "docker compose -f docker/docker-compose.yml build demo",
    "docker:build:landing": "docker compose -f docker/docker-compose.yml build landing-page",
    "docker:build:worker": "docker compose -f docker/docker-compose.yml --profile worker build server-worker",
    "docker:build:all": "pnpm build && docker compose -f docker/docker-compose.yml --profile worker build",
    "pretypecheck": "pnpm --filter @dream-invoice/database db:generate",
    "test:flows": "node --test tests/flows/**/*.spec.mjs",
    "test:flows:live": "DREAM_INVOICE_FLOW_LIVE=1 node --test tests/flows/**/*.spec.mjs",
    "docker:dev:up": "docker compose -f docker/development/docker-compose.yml up -d",
    "docker:dev:down": "docker compose -f docker/development/docker-compose.yml down",
    "docker:dev:logs": "docker compose -f docker/development/docker-compose.yml logs -f",
    "docker:dev:ps": "docker compose -f docker/development/docker-compose.yml ps"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "eslint-plugin-import": "^2",
    "eslint-plugin-unused-imports": "^4",
    "turbo": "latest",
    "typescript": "latest"
  }
}
