{
  "name": "dream-invoice",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev:web": "pnpm --filter @dream-invoice/web dev",
    "dev:accounting": "pnpm --filter @dream-invoice/accounting dev",
    "dev:admin": "pnpm --filter @dream-invoice/admin dev",
    "dev:server": "pnpm --filter @dream-invoice/server dev",
    "db:generate": "pnpm --filter @dream-invoice/database db:generate",
    "db:migrate": "pnpm --filter @dream-invoice/database db:migrate",
    "db:studio": "pnpm --filter @dream-invoice/database db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:deploy": "pnpm --filter @dream-invoice/database db:deploy",
    "docker:build": "docker compose -f docker-compose.yml -f docker-compose.build.yml build",
    "docker:restart": "docker compose restart",
    "prebuild": "pnpm --filter @dream-invoice/database db:generate",
    "docker:build:web": "docker compose -f docker-compose.yml -f docker-compose.build.yml build web-app",
    "docker:build:demo": "docker compose -f docker/public-site.compose.yml build demo-app",
    "docker:build:landing": "docker compose -f docker/public-site.compose.yml build landing-page",
    "docker:build:all": "pnpm build && docker compose -f docker-compose.yml -f docker-compose.build.yml build && docker compose -f docker/public-site.compose.yml build",
    "pretypecheck": "pnpm --filter @dream-invoice/database db:generate",
    "test:flows": "node --test tests/flows/**/*.spec.mjs",
    "test:flows:live": "DREAM_INVOICE_FLOW_LIVE=1 node --test tests/flows/**/*.spec.mjs",
    "docker:dev:up": "docker compose -f docker/development/docker-compose.yml up -d",
    "docker:dev:down": "docker compose -f docker/development/docker-compose.yml down",
    "docker:dev:logs": "docker compose -f docker/development/docker-compose.yml logs -f",
    "docker:dev:ps": "docker compose -f docker/development/docker-compose.yml ps",
    "release:check": "node tools/public-release/verify-public-release.mjs && pnpm --filter @dream-invoice/demo check:safety && pnpm --filter @dream-invoice/landing-page check:safety",
    "security:audit": "pnpm audit --audit-level moderate",
    "release:quality": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm release:check && pnpm security:audit",
    "docker:public:up": "docker compose -f docker/public-site.compose.yml up -d",
    "docker:public:down": "docker compose -f docker/public-site.compose.yml down",
    "docker:public:logs": "docker compose -f docker/public-site.compose.yml logs -f",
    "docker:public:build": "docker compose -f docker/public-site.compose.yml build"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-import": "^2",
    "eslint-plugin-unused-imports": "^4",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "next": "16.2.6",
      "eslint-config-next": "16.2.6",
      "postcss": "8.5.10",
      "effect": "3.20.0",
      "ws": "8.21.0",
      "js-yaml": "4.2.0",
      "@babel/core": "7.29.7"
    }
  }
}
