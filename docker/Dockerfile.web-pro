# Inactive Web-Pro Dockerfile prepared for a future runtime switch.
# Current production Dockerfile remains docker/Dockerfile and still starts @dream-invoice/web.

FROM node:22-bookworm-slim

ENV PNPM_HOME="/pnpm"
ENV COREPACK_HOME="/pnpm/corepack"
ENV PATH="$PNPM_HOME:$PATH"
ENV NODE_ENV="production"
ENV PORT="3020"
ENV WEB_PRO_PORT="3020"
ENV HOSTNAME="0.0.0.0"
ENV DREAM_INVOICE_RUNTIME="web-pro-preview"
ENV LICENSE_ACTIVATION_MODE="cloud"
ENV LICENSE_OFFLINE_MODE="false"
ENV NEXT_PUBLIC_LICENSE_RUNTIME="web-pro-preview"
ENV PUPPETEER_SKIP_DOWNLOAD="true"
ENV PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    chromium \
    fonts-liberation \
    openssl \
    poppler-utils \
    postgresql-client \
    tesseract-ocr \
    tesseract-ocr-deu \
    tesseract-ocr-eng \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable
RUN groupadd --system dreaminvoice && useradd --system --gid dreaminvoice --home /app dreaminvoice

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.json eslint.config.mjs ./
COPY apps ./apps
COPY packages ./packages
COPY database ./database
COPY docker/scripts ./docker/scripts
COPY assets ./assets

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @dream-invoice/database db:generate
RUN pnpm --filter @dream-invoice/premium build
RUN pnpm --filter @dream-invoice/web-pro build

EXPOSE 3020

HEALTHCHECK --interval=30s --timeout=5s --retries=5 CMD node -e "fetch('http://127.0.0.1:3020/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

RUN mkdir -p data "$COREPACK_HOME" && chown dreaminvoice:dreaminvoice data

USER dreaminvoice

ENTRYPOINT ["sh", "docker/scripts/docker-entrypoint.sh"]
CMD ["pnpm", "--filter", "@dream-invoice/web-pro", "exec", "next", "start", "-H", "0.0.0.0", "-p", "3020"]
