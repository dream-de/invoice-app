# Dream Invoice local development helpers
# Copy to docker/development/.env when you want custom local ports or credentials.

DREAM_INVOICE_DEV_POSTGRES_USER=dream_invoice
DREAM_INVOICE_DEV_POSTGRES_PASSWORD=dream_invoice_dev_password
DREAM_INVOICE_DEV_POSTGRES_DB=dream_invoice
DREAM_INVOICE_DEV_POSTGRES_PORT=55433

# Use this DATABASE_URL when running the web app from your host machine.
DATABASE_URL=postgresql://dream_invoice:dream_invoice_dev_password@127.0.0.1:55433/dream_invoice

# Local email testing. No real emails leave your machine.
DREAM_INVOICE_MAILPIT_SMTP_PORT=1025
DREAM_INVOICE_MAILPIT_WEB_PORT=8025
DREAM_INVOICE_MAILPIT_MAX_MESSAGES=5000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

DREAM_INVOICE_ADMINER_PORT=8081
