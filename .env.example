# App
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="Invoice Platform"
AUTH_SECRET="change-this-secret-before-production"

# Public app port
INVOICE_PORT=3000

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=invoice_platform
POSTGRES_PORT=55432

# Docker Compose database URL
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/invoice_platform"


# License verification
# Public key used by the app to verify signed license keys.
# The private key must never be committed or deployed to customer systems.
LICENSE_PUBLIC_KEY=""
