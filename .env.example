# Dream Invoice Docker installation template.
# Copy this file to .env for manual installs:
#   cp .env.example .env
#
# Recommended quick install with generated secrets:
#   ./scripts/install.sh
#
# SECURITY: This file intentionally contains placeholders, not usable production secrets.
# Replace every CHANGE_ME_* value before starting a real installation.

# App
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="Dream Invoice"

# Generate with: openssl rand -hex 32
AUTH_SECRET=CHANGE_ME_GENERATE_RANDOM_AUTH_SECRET
# Keep false for local HTTP/LXC testing. Set true when the public app URL uses HTTPS.
AUTH_COOKIE_SECURE=false

# Deployment Basic Auth for exposed self-hosted installations.
# Keep disabled for the first local HTTP start. Enable it before exposing a real production installation.
DREAM_INVOICE_AUTH_USER=admin
DREAM_INVOICE_AUTH_PASSWORD=CHANGE_ME_SET_STRONG_DEPLOYMENT_PASSWORD
DREAM_INVOICE_AUTH_REQUIRED=false

# Login throttling. Defaults are suitable for most small self-hosted installs.
DREAM_INVOICE_LOGIN_WINDOW_MS=900000
DREAM_INVOICE_LOGIN_MAX_ATTEMPTS=8

# Admin app protection. The admin foundation should not be exposed without auth.
DREAM_INVOICE_ADMIN_USER=admin
DREAM_INVOICE_ADMIN_PASSWORD=CHANGE_ME_SET_STRONG_ADMIN_PASSWORD
DREAM_INVOICE_ADMIN_AUTH_REQUIRED=true

# Product stack ports.
# WEB_PORT exposes the Dream Invoice web app.
# HTTP_PORT is only used when starting the optional Nginx proxy profile.
# POSTGRES_PORT binds PostgreSQL locally by default.
HTTP_PORT=80
WEB_PORT=3010
POSTGRES_PORT=127.0.0.1:5432

# PostgreSQL
# Generate a strong password before starting the stack.
POSTGRES_USER=dream_invoice
POSTGRES_PASSWORD=CHANGE_ME_SET_STRONG_DATABASE_PASSWORD
POSTGRES_DB=dream_invoice

# Docker images
# Normal installs pull these prebuilt images. Maintainers can override them.
DREAM_INVOICE_IMAGE=ghcr.io/dream-de/invoice-app:latest

# License verification
# Public key used by the app to verify signed license keys.
# The private key must never be committed or deployed to customer systems.
LICENSE_PUBLIC_KEY=""
