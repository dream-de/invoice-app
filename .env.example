# App
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="Dream Invoice"

# Production security:
# Always replace AUTH_SECRET and POSTGRES_PASSWORD before deploying.
# Generate strong values with:
#   openssl rand -base64 32
AUTH_SECRET="change-this-secret-before-production"

# Optional deployment Basic Auth for exposed self-hosted installations.
# Set DREAM_INVOICE_AUTH_PASSWORD to protect the web UI and API with browser Basic Auth.
# Set DREAM_INVOICE_AUTH_REQUIRED=true to fail closed when the password is missing.
DREAM_INVOICE_AUTH_USER=admin
DREAM_INVOICE_AUTH_PASSWORD=""
DREAM_INVOICE_AUTH_REQUIRED=false

# Admin app protection. The admin foundation should not be exposed without auth.
DREAM_INVOICE_ADMIN_USER=admin
DREAM_INVOICE_ADMIN_PASSWORD=""
DREAM_INVOICE_ADMIN_AUTH_REQUIRED=true

# Public app port
WEB_PORT=3000

# PostgreSQL
# The default password is only for local development.
# For production, set a unique value generated with:
#   openssl rand -base64 32
POSTGRES_USER=dream_invoice
POSTGRES_PASSWORD=dream_invoice_dev_password
POSTGRES_DB=dream_invoice
POSTGRES_PORT=55432

# Docker Compose database URL
DATABASE_URL="postgresql://dream_invoice:dream_invoice_dev_password@postgres:5432/dream_invoice"


# License verification
# Public key used by the app to verify signed license keys.
# The private key must never be committed or deployed to customer systems.
LICENSE_PUBLIC_KEY=""

# Server worker
# Used by Docker, PM2 or cron when scheduled jobs should run outside the web app.
SERVER_WORKER_MODE=scheduled
SERVER_WORKER_SCHEDULE_FILE="config/schedules.example.json"
SERVER_WORKER_LIMIT=25
SERVER_WORKER_NOW=""
