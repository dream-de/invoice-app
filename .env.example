# Dream Invoice Docker installation template.
# Copy this file to .env for manual installs:
#   cp .env.example .env
#
# Quick installs can use:
#   ./scripts/install.sh

# App
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="Dream Invoice"

# Default values are start-friendly for local/LXC testing.
# Change all default passwords and secrets before real production use.
# Generate strong values with:
#   openssl rand -base64 32
AUTH_SECRET="dream-invoice-change-this-secret"

# Deployment Basic Auth for exposed self-hosted installations.
# Change the default password before real production use.
DREAM_INVOICE_AUTH_USER=admin
DREAM_INVOICE_AUTH_PASSWORD="dreaminvoice"
DREAM_INVOICE_AUTH_REQUIRED=true

# Admin app protection. The admin foundation should not be exposed without auth.
DREAM_INVOICE_ADMIN_USER=admin
DREAM_INVOICE_ADMIN_PASSWORD="dreaminvoice-admin"
DREAM_INVOICE_ADMIN_AUTH_REQUIRED=true

# Product stack ports.
# HTTP_PORT is the Nginx/app proxy port.
# WEB_PORT binds the internal Next app locally by default.
# POSTGRES_PORT binds PostgreSQL locally by default.
HTTP_PORT=80
WEB_PORT=127.0.0.1:3000
POSTGRES_PORT=127.0.0.1:5432

# PostgreSQL
# Change POSTGRES_PASSWORD before real production use. The installer script generates it.
POSTGRES_USER=dream_invoice
POSTGRES_PASSWORD="dream_invoice_password"
POSTGRES_DB=dream_invoice

# License verification
# Public key used by the app to verify signed license keys.
# The private key must never be committed or deployed to customer systems.
LICENSE_PUBLIC_KEY=""

# Server worker
# Used by Docker, PM2, or cron when scheduled jobs should run outside the web app.
SERVER_WORKER_MODE=scheduled
SERVER_WORKER_SCHEDULE_FILE="config/schedules.example.json"
SERVER_WORKER_LIMIT=25
SERVER_WORKER_NOW=""
