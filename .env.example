# Dream Invoice Docker installation template.
# Copy this file to .env for manual installs:
#   cp .env.example .env
#
# Quick installs can use:
#   ./scripts/install.sh

# App
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="Dream Invoice"

# These defaults are intentionally simple so the first Docker start works.
# Change all default passwords and secrets before real production use.
# Generate production secrets with: openssl rand -hex 32
AUTH_SECRET=1111111111111111111111111111111111111111111111111111111111111111
# Keep false for local HTTP/LXC testing. Set true when the public app URL uses HTTPS.
AUTH_COOKIE_SECURE=false

# Deployment Basic Auth for exposed self-hosted installations.
# Change before exposing a real production installation.
DREAM_INVOICE_AUTH_USER=admin
DREAM_INVOICE_AUTH_PASSWORD=dreaminvoice
DREAM_INVOICE_AUTH_REQUIRED=true

# Admin app protection. The admin foundation should not be exposed without auth.
# Change before exposing a real production installation.
DREAM_INVOICE_ADMIN_USER=admin
DREAM_INVOICE_ADMIN_PASSWORD=dreaminvoice
DREAM_INVOICE_ADMIN_AUTH_REQUIRED=true

# Product stack ports.
# WEB_PORT exposes the Dream Invoice web app.
# HTTP_PORT is only used when starting the optional Nginx proxy profile.
# POSTGRES_PORT binds PostgreSQL locally by default.
HTTP_PORT=80
WEB_PORT=3000
POSTGRES_PORT=127.0.0.1:5432

# PostgreSQL
# Defaults keep first-time Docker installs simple. Change POSTGRES_PASSWORD before real production use.
# If you change these values after first start, recreate or migrate the database volume accordingly.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dream_invoice

# Docker images
# Normal installs pull these prebuilt images. Maintainers can override them.
DREAM_INVOICE_IMAGE=ghcr.io/dream-de/invoice-app:latest

# License verification
# Public key used by the app to verify signed license keys.
# The private key must never be committed or deployed to customer systems.
LICENSE_PUBLIC_KEY=""

